# --- Option A: Nebius Token Factory (what the hackathon requires) ---
# NEBIUS_API_KEY=your_token_factory_key
# NEBIUS_MODEL_ID=<id from: python scripts/infrasec_explain.py --list-models>
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# --- Option B: NVIDIA-hosted Nemotron (fallback, NOT Nebius) ---
NEBIUS_API_KEY=nvapi-your_key_from_build.nvidia.com
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
NEBIUS_MODEL_ID=<a Nemotron id from --list-models>

# --- GitLab (needed for MR notes and pushing the fix) ---
INFRASEC_TOKEN=your_project_access_token