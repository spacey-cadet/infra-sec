@@ -121,3 +121,17 @@ deploy:production:
   extends: .deploy
   needs: ["infrasec:decide", "deploy:staging"]
   environment: { name: production }
+
+# When the gate (or any job) fails on a branch with an open merge request, post the report
+# and mention the Duo flow. Mentioning a flow in a comment triggers it, so this makes the
+# auto-fix loop hands-off without depending on the project's "pipeline failed" trigger.
+# Needs two CI/CD variables: INFRASEC_TOKEN (project access token, api scope, Developer)
+# and INFRASEC_FLOW_HANDLE (the @handle GitLab autocompletes for the flow).
+infrasec:notify:
+  stage: .post
+  image: python:3.12-slim
+  rules:
+    - if: $CI_COMMIT_BRANCH && $CI_COMMIT_BRANCH != $CI_DEFAULT_BRANCH
+      when: on_failure
+  script:
+    - python scripts/infrasec_notify.py
