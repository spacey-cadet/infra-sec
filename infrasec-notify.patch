+#!/usr/bin/env python3
+"""Post the InfraSec report on the merge request and mention the Duo flow.
+
+Runs from the pipeline's `.post` stage when a job failed. Mentioning the flow in a
+comment is the documented way to trigger a custom flow, so this makes the hands-off
+loop independent of the project's "pipeline failed" trigger setting.
+
+Environment:
+  INFRASEC_TOKEN        project access token (api scope, Developer role)  [required]
+  INFRASEC_FLOW_HANDLE  the @handle GitLab autocompletes for the flow     [required]
+  CI_API_V4_URL, CI_PROJECT_ID, CI_COMMIT_REF_NAME, CI_PIPELINE_ID        [set by GitLab]
+
+Never fails the pipeline: a missing token or MR just prints what to do.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+
+def _api(method: str, url: str, token: str, payload: dict | None = None):
+    data = json.dumps(payload).encode() if payload is not None else None
+    req = urllib.request.Request(url, data=data, method=method,
+                                 headers={"PRIVATE-TOKEN": token, "Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=30) as resp:
+        return json.loads(resp.read() or b"null")
+
+
+def main(env=None, report_path: str = "infrasec-report.md") -> int:
+    env = os.environ if env is None else env
+    token, handle = env.get("INFRASEC_TOKEN", ""), env.get("INFRASEC_FLOW_HANDLE", "")
+    if not token or not handle:
+        print("INFRASEC_TOKEN / INFRASEC_FLOW_HANDLE not set: skipping the MR comment.\n"
+              "Set both CI/CD variables to make the auto-fix loop hands-off.")
+        return 0
+    base = f"{env['CI_API_V4_URL']}/projects/{env['CI_PROJECT_ID']}"
+    branch = env["CI_COMMIT_REF_NAME"]
+    try:
+        mrs = _api("GET", f"{base}/merge_requests?state=opened&source_branch={urllib.parse.quote(branch, safe='')}", token)
+        if not mrs:
+            print(f"No open merge request for branch '{branch}'. Open one and the next push will notify the flow.")
+            return 0
+        iid = mrs[0]["iid"]
+        report = Path(report_path).read_text() if Path(report_path).exists() else "(no InfraSec report found)"
+        body = (f"{handle} InfraSec held this change (pipeline #{env.get('CI_PIPELINE_ID', '?')}). "
+                "Follow your instructions: read the `infrasec:decide` job log, explain why it did not pass, "
+                "and fix it if every finding is auto-fixable.\n\n" + report)
+        _api("POST", f"{base}/merge_requests/{iid}/notes", token, {"body": body})
+        print(f"Posted the report and mentioned {handle} on MR !{iid}.")
+    except (urllib.error.URLError, KeyError, ValueError) as exc:
+        print(f"Could not notify the flow: {exc}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/test_notify.py b/tests/test_notify.py
new file mode 100644
index 0000000..6c294bc
--- /dev/null
+++ b/tests/test_notify.py
@@ -0,0 +1,91 @@
+import json
+import os
+import sys
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from scripts.infrasec_notify import main  # noqa: E402
+
+
+class FakeGitLab:
+    """Tiny stand-in for the GitLab API that records requests."""
+
+    def __init__(self, mrs):
+        outer = self
+        self.mrs, self.requests = mrs, []
+
+        class Handler(BaseHTTPRequestHandler):
+            def _reply(self, payload):
+                body = json.dumps(payload).encode()
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.end_headers()
+                self.wfile.write(body)
+
+            def do_GET(self):
+                outer.requests.append(("GET", self.path, self.headers.get("PRIVATE-TOKEN"), None))
+                self._reply(outer.mrs)
+
+            def do_POST(self):
+                length = int(self.headers.get("Content-Length", 0))
+                outer.requests.append(("POST", self.path, self.headers.get("PRIVATE-TOKEN"),
+                                       json.loads(self.rfile.read(length))))
+                self._reply({"id": 1})
+
+            def log_message(self, *a):
+                pass
+
+        self.server = HTTPServer(("127.0.0.1", 0), Handler)
+        threading.Thread(target=self.server.serve_forever, daemon=True).start()
+        self.url = f"http://127.0.0.1:{self.server.server_port}/api/v4"
+
+    def close(self):
+        self.server.shutdown()
+
+
+def env_for(gl, **extra):
+    env = {"CI_API_V4_URL": gl.url, "CI_PROJECT_ID": "7", "CI_COMMIT_REF_NAME": "demo/open-ssh",
+           "CI_PIPELINE_ID": "99", "INFRASEC_TOKEN": "tok", "INFRASEC_FLOW_HANDLE": "@ai-infrasec-autofix"}
+    env.update(extra)
+    return env
+
+
+def test_posts_report_and_mentions_flow_on_the_branchs_mr(tmp_path):
+    report = tmp_path / "r.md"
+    report.write_text("## InfraSec: **HELD**\nNETWORK_OPEN_TO_WORLD")
+    gl = FakeGitLab([{"iid": 12}])
+    try:
+        assert main(env_for(gl), str(report)) == 0
+    finally:
+        gl.close()
+    get, post = gl.requests
+    assert "source_branch=demo%2Fopen-ssh" in get[1] and get[2] == "tok"
+    assert post[1].endswith("/projects/7/merge_requests/12/notes")
+    assert post[3]["body"].startswith("@ai-infrasec-autofix")
+    assert "NETWORK_OPEN_TO_WORLD" in post[3]["body"] and "#99" in post[3]["body"]
+
+
+def test_no_open_mr_posts_nothing_and_does_not_fail(tmp_path):
+    gl = FakeGitLab([])
+    try:
+        assert main(env_for(gl), str(tmp_path / "missing.md")) == 0
+    finally:
+        gl.close()
+    assert [r[0] for r in gl.requests] == ["GET"]
+
+
+def test_missing_token_or_handle_skips_without_calling_the_api(tmp_path, capsys):
+    gl = FakeGitLab([{"iid": 1}])
+    try:
+        assert main(env_for(gl, INFRASEC_TOKEN=""), str(tmp_path / "r.md")) == 0
+    finally:
+        gl.close()
+    assert gl.requests == [] and "not set" in capsys.readouterr().out
+
+
+def test_unreachable_api_never_fails_the_pipeline(tmp_path):
+    env = {"CI_API_V4_URL": "http://127.0.0.1:9/api/v4", "CI_PROJECT_ID": "7", "CI_COMMIT_REF_NAME": "b",
+           "INFRASEC_TOKEN": "tok", "INFRASEC_FLOW_HANDLE": "@f"}
+    assert main(env, str(tmp_path / "r.md")) == 0
